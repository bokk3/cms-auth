# CMS Authentication System Environment Configuration
# Copy this to .env and update with your actual values

# Database Configuration
DB_HOST=mariadb
DB_NAME=login_system
DB_USER=app_user
DB_PASS=app_password

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_MODE=test

# Application Configuration
APP_URL=http://localhost:8083
APP_NAME="CMS Auth System"
APP_ENV=development

# Session Configuration
SESSION_TIMEOUT=1800
SESSION_COOKIE_NAME=cms_auth_session

# Email Configuration (for receipts and notifications)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_FROM_ADDRESS=noreply@cmsauth.local
MAIL_FROM_NAME="CMS Auth System"